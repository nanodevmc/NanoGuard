{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoGuard",
  "version": "0.1.2",
  "identifier": "com.nanodev.nanoguard",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "NanoGuard Bytecode Armor",
        "width": 1140,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/engine/*"
    ]
  }
}
